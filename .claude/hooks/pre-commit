#!/bin/sh
# feature-plan pipeline guard (pre-commit) — a pass-through, deliberately.
#
# This hook enforces nothing. It used to require every code commit to stage a docs/commits/
# explanation; that artifact was retired on 2026-08-08 in favour of the commit message itself,
# which hooks/commit-msg guards. Nothing replaced it here, because "is this message any good" is
# not a question a hook can answer — the standard lives in commit-plan-implementer's agreement.
#
# THE FILE STILL EXISTS ON PURPOSE. hooks/pipeline-marker.sh sets core.hooksPath to this directory
# with `git config --local`, and never unsets it, so a repo that has ever run the pipeline looks
# for its hooks here from then on. Deleting this file would therefore silently stop running that
# project's own pre-commit hook — during a run and outside one, forever, with nothing reporting it.
# Chaining is the whole job.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

local_hook="$git_dir/hooks/pre-commit"
[ -x "$local_hook" ] && exec "$local_hook" "$@"
exit 0
