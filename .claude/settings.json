{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash /Users/var-pi/.claude/statusline-command.sh",
    "refreshInterval": 3000
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "preferredNotifChannel": "kitty",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^commit-plan-implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/var-pi/.claude/hooks/pipeline-marker.sh arm"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^commit-plan-implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/var-pi/.claude/hooks/pipeline-marker.sh disarm"
          }
        ]
      }
    ]
  }
}
